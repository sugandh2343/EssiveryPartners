# Backend API used by the Partner frontend.
VITE_API_BASE_URL=https://essivery.in/api/partner

# Google Maps JavaScript API browser key. Restrict it by HTTP referrer to:
#   http://localhost:5173/*
#   https://partners.essivery.in/*
# Enable Maps JavaScript API and billing in the same Google Cloud project.
VITE_GOOGLE_MAPS_API_KEY=replace_with_your_referrer_restricted_browser_key
VITE_GOOGLE_MAPS_MAP_ID=replace_with_your_google_maps_map_id

# Optional. The standard draggable marker works without a Map ID.

VITE_GOOGLE_MAPS_REGION=IN
VITE_GOOGLE_MAPS_LANGUAGE=en
